`</field><data>{"commentRefs":[],"fieldData":{"img":null}}</data></shadow></value><value name="kind"><shadow type="spritekind" id="fF*rO;D1z)jIA2!5b]{w"><field name="MEMBER">Mouse</field></shadow></value></block></value><next><block type="game_control_sprite" id="u-Z2F5^i$XLtr=02}3mc"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><value name="sprite"><block type="variables_get" id="Y`8c2I)e{J_C_+Sp2$-~"><field name="VAR" id="Rl(W-nLdxE.}_Er~)J@L">MouseSprite</field></block></value><value name="vx"><shadow type="spriteSpeedPicker" id="!Tz!oLx+{pmR?N6[E7h#"><field name="speed">100</field></shadow></value><value name="vy"><shadow type="spriteSpeedPicker" id="fn2bS(g4[__vB.C),:OT"><field name="speed">100</field></shadow></value><next><block type="variables_set" id="F`f2E4bCFM;[]sW)F^9k"><field name="VAR" id="Afz:yCnVM^R!KG2Or^Pa">Things cat can say</field><value name="VALUE"><block type="lists_create_with" id="Z-htIino84vP[xyU:D$|" inline="false"><mutation items="20" horizontalafter="3"></mutation><value name="ADD0"><shadow type="text" id="l32;nsyWcjn65g_:c.@u"><field name="TEXT">No more battle cats till you do your homework!!!</field></shadow></value><value name="ADD1"><shadow type="text" id="nX}PUJoW!ow,T;mYk1qn"><field name="TEXT">Download TheBattleCats on IOS Playstore and others.  </field></shadow></value><value name="ADD2"><shadow type="text" id="_+h[]@ADcXzNBK{u)rdx"><field name="TEXT">Meow Meow Meow Meow!</field></shadow></value><value name="ADD3"><shadow type="text" id="X@:/l[%*[j|bzkAH{cvG"><field name="TEXT">Cats love cat food!! ALL FOR CAT FOOD!!</field></shadow></value><value name="ADD4"><shadow type="text" id="}f|L0*^jM7cKya}d0q[D"><field name="TEXT"> CUL says: Don't watch JJK</field></shadow></value><value name="ADD5"><shadow type="text" id=":/ttq;7Pg4g-d}U?[|0w"><field name="TEXT">Did you know that CUL thinks charmy is a bum</field></shadow></value><value name="ADD6"><shadow type="text" id="H^0)Ys#a,yEguuxi4]V5"><field name="TEXT">PAPALUGA IS THE BEST UBER</field></shadow></value><value name="ADD7"><shadow type="text" id="15Xp;_^hN4dgm=$S7(p~"><field name="TEXT">It's ok to cry. you wern't made that strong.</field></shadow></value><value name="ADD8"><shadow type="text" id=":HR1L{9BC_6xm#4MV*MG"><field name="TEXT">PSM CCM and CUL made this game!</field></shadow></value><value name="ADD9"><shadow type="text" id="aOliVrBDb+s4p-AP5[;8"><field name="TEXT">PSM says: Dont watch one piece</field></shadow></value><value name="ADD10"><shadow type="text" id="1llK`4{3/HIb2/cPAnt,"><field name="TEXT">did you know? CUL: 10% of game PSM did 15% of game and CCM did 75% of game</field></shadow></value><value name="ADD11"><shadow type="text" id="%|WFbg_hL{Kis0qe6BM2"><field name="TEXT">did you know, CUL is CupOfLemon? go subscribe to him!</field></shadow></value><value name="ADD12"><shadow type="text" id="JdUDo;qI=08kvVo;G`^D"><field name="TEXT">did you know? psm is pepsiman?</field></shadow></value><value name="ADD13"><shadow type="text" id="eT/r!@zy974-1JJtG*WT"><field name="TEXT">aura monster</field></shadow></value><value name="ADD14"><shadow type="text" id="`}/%fnIu)~?$8eqYf^R^"><field name="TEXT">KuromiBC is a larper!!!!!!!</field></shadow></value><value name="ADD15"><shadow type="text" id="s#)6q3HGr!|D_W)NeKTy"><field name="TEXT">cats that battle</field></shadow></value><value name="ADD16"><shadow type="text" id="?!z30=Pa6h!y7p`C1nag"><field name="TEXT">subscribe to earlyMorning Humor!!!!!!!</field></shadow></value><value name="ADD17"><shadow type="text" id="3I-b|bM!n-F4Nzh/d%wx"><field name="TEXT">EVERYTHING I SAY IS SATIRE (except the credits and the cupoflemon thing)</field></shadow></value><value name="ADD18"><shadow type="text" id="d.W/HR`-%vz)u9sAXxxM"><field name="TEXT">when the night begins to shine...............</field></shadow></value><value name="ADD19"><shadow type="text" id=")0h%OBV:ds),GduAwEo$"><field name="TEXT">Collab with "the prickel" soon!</field></shadow></value></block></value><next><block type="spritesetpos" id="7OpiwgKY,7:?VN`Tf#ax"><value name="sprite"><block type="variables_get" id="+fGGOkz^Q=mHv5aaSH:B"><field name="VAR" id="[Key7g/zEs,[}lA{[zjz">BattleCatNPC</field></block></value><value name="x"><shadow type="positionPicker" id="mee1B?i*^[G!^~FQ~Slb"><field name="index">114</field></shadow></value><value name="y"><shadow type="positionPicker" id="0[VzV^:ed-s)cTW)RHbE"><field name="index">85</field></shadow></value><next><block type="variables_set" id="y(3{Cz8C|fh-I/x6-DyW"><field name="VAR" id="aH!YG$[n?cHs0M|By4-C">TranistioningScreen</field><value name="VALUE"><shadow type="math_number" id="!,PT*%g0^pQw)E4Wsw[~"><field name="NUM">0</field></shadow><block type="spritescreate" id="2Fj`:OVqQU/w3uVmkq]n"><value name="img"><shadow type="screen_image_picker" id="O~9%H(%?k*oT!1UWFGC9"><field name="img">img`
