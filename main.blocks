="TEXT">PAPALUGA IS THE BEST UBER</field></shadow></value><value name="ADD7"><shadow type="text" id="Lv)Jv7|/({s)JVsjkr}!"><field name="TEXT">It's ok to cry. you wern't made that strong.</field></shadow></value></block></value><next><block type="spritesetpos" id="~5[SQ%I2+gWuk~ugm`!$"><value name="sprite"><block type="variables_get" id="TaI=2eV4HZU?0IE:=GZL"><field name="VAR" id="F0TtbFN5xq5YuEk]Fbn6">mySprite</field></block></value><value name="x"><shadow type="positionPicker" id="y~qH.mj[-X!D?z$*hGz9"><field name="index">114</field></shadow></value><value name="y"><shadow type="positionPicker" id="r!)TBRZ^b{go1_S=9%a!"><field name="index">85</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="spritesoverlap" id="*p|BB:IL+M:K7EBP6~)$" x="1137" y="207"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="WF|v@H6s,VL{V(4~]H?B" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="=*Y9`th/#/#ZQJ}[6U}+"><field name="MEMBER">Mouse</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id=")PpJ.j%@tveYJ$[jx,3e" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id=")JXME9h;JNEP%FEDyAFF"><field name="MEMBER">Tankicon</field></shadow></value><statement name="HANDLER"><block type="timer_throttle" id="_FGqNC+YaCVQ2(Vsdyd~"><value name="key"><shadow type="text" id="+A_a=A%-.@|+6YR;GHYJ"><field name="TEXT">action</field></shadow></value><value name="time"><shadow type="math_number" id="U=f:~%:U8E:R#hDMmVLy"><field name="NUM">15000</field></shadow></value><statement name="HANDLER"><block type="cont